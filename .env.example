# Safe to expose in the browser. Use the publishable key, never service_role.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Existing Vercel/Supabase integrations may provide this legacy-compatible name instead.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_legacy_anon_key

# Server-only. Configure directly in Vercel; never commit real values.
SUPABASE_SERVICE_ROLE_KEY=replace_in_vercel_only
CRON_SECRET=replace_in_vercel_only
TCF_OWNER_USER_ID=replace_with_supabase_auth_user_uuid
TCF_INGEST_SECRET=replace_in_vercel_only

# Provider secrets are server-only. Integrations reference names, not values.
TCF_STRIPE_SECRET_KEY=replace_in_vercel_only
TCF_STRIPE_WEBHOOK_SECRET=replace_in_vercel_only
TCF_STRIPE_BUSINESS_ID=replace_with_business_uuid
TCF_YOUTUBE_API_KEY=replace_in_vercel_only
TCF_TIKTOK_ACCESS_TOKEN=replace_after_oauth_approval
TCF_INSTAGRAM_ACCESS_TOKEN=replace_after_meta_oauth
