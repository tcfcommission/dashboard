   ADMIN PANEL — dynamic add/remove blocks
   ============================================================ */
function openAdmin(){populateAdmin();document.getElementById('admin').classList.add('open');document.getElementById('adminOverlay').classList.add('open');}
function closeAdmin(){document.getElementById('admin').classList.remove('open');document.getElementById('adminOverlay').classList.remove('open');}

function populateAdmin(){
  document.getElementById('a_name').value=DATA.name||'';
  document.getElementById('a_pass').value=DATA.password||'';
  renderAdminSocials();renderAdminBiz();renderAdminGoals();
}

function renderAdminSocials(){
  document.getElementById('a_socials').innerHTML=DATA.socials.map((s,i)=>`
    <div class="admin-block" data-i="${i}">
      <div class="admin-block-hd"><span class="admin-block-ti">Social ${i+1}</span><button class="block-del" onclick="delSocial(${i})">Delete</button></div>
      <div class="field"><label class="field-l">Platform</label>
        <select class="field-i as-platform">
          <option value="tiktok"${s.platform==='tiktok'?' selected':''}>TikTok</option>
          <option value="instagram"${s.platform==='instagram'?' selected':''}>Instagram</option>
          <option value="youtube"${s.platform==='youtube'?' selected':''}>YouTube</option>
          <option value="twitter"${s.platform==='twitter'?' selected':''}>X / Twitter</option>
          <option value="snapchat"${s.platform==='snapchat'?' selected':''}>Snapchat</option>
          <option value="other"${s.platform==='other'?' selected':''}>Other</option>
        </select>
      </div>
      <div class="field"><label class="field-l">Handle</label><input class="field-i as-handle" value="${s.handle||''}" placeholder="@yourhandle"></div>
      <div class="field-row">
        <div class="field"><label class="field-l">Followers</label><input class="field-i as-followers" type="number" value="${s.followers||0}"></div>
        <div class="field"><label class="field-l">Views</label><input class="field-i as-views" type="number" value="${s.views||0}"></div>
      </div>
      <div class="field"><label class="field-l">Growth %</label><input class="field-i as-growth" type="number" value="${s.growth||0}"></div>
    </div>`).join('');
}
function renderAdminBiz(){
  document.getElementById('a_biz').innerHTML=DATA.businesses.map((b,i)=>`
    <div class="admin-block" data-i="${i}">
      <div class="admin-block-hd"><span class="admin-block-ti">Business ${i+1}</span><button class="block-del" onclick="delBiz(${i})">Delete</button></div>
      <div class="field-row">
        <div class="field"><label class="field-l">Emoji</label><input class="field-i ab-emoji" value="${b.emoji||''}" placeholder="🖤" maxlength="4"></div>
        <div class="field"><label class="field-l">Name</label><input class="field-i ab-name" value="${b.name||''}" placeholder="Business name"></div>
      </div>
      <div class="field-row">
        <div class="field"><label class="field-l">Revenue (£)</label><input class="field-i ab-revenue" type="number" value="${b.revenue||0}"></div>
        <div class="field"><label class="field-l">Sales</label><input class="field-i ab-sales" type="number" value="${b.sales||0}"></div>
      </div>
      <div class="field"><label class="field-l">Source</label>
        <select class="field-i ab-source">
          <option value="manual"${b.source!=='stripe'?' selected':''}>Manual</option>
          <option value="stripe"${b.source==='stripe'?' selected':''}>Stripe (API-ready)</option>
        </select>
      </div>
    </div>`).join('');
}
function renderAdminGoals(){
  document.getElementById('a_goals').innerHTML=DATA.goals.map((g,i)=>`
    <div class="admin-block" data-i="${i}">
      <div class="admin-block-hd"><span class="admin-block-ti">Goal ${i+1}</span><button class="block-del" onclick="delGoal(${i})">Delete</button></div>
      <div class="field"><label class="field-l">Goal name</label><input class="field-i ag-name" value="${g.name||''}" placeholder="First £1,000 month"></div>
      <div class="field-row">
        <div class="field"><label class="field-l">Current</label><input class="field-i ag-current" type="number" value="${g.current||0}"></div>
        <div class="field"><label class="field-l">Target</label><input class="field-i ag-target" type="number" value="${g.target||0}"></div>
      </div>
    </div>`).join('');
}

/* read admin DOM back into DATA before mutating list (so unsaved edits survive add/delete) */
function syncAdminToData(){
  DATA.name=document.getElementById('a_name').value.trim()||'Shadow';
  const pass=document.getElementById('a_pass').value.trim();if(pass)DATA.password=pass;
  document.querySelectorAll('#a_socials .admin-block').forEach((bl,i)=>{
    if(!DATA.socials[i])return;
    DATA.socials[i].platform=bl.querySelector('.as-platform').value;
    DATA.socials[i].handle=bl.querySelector('.as-handle').value;
    DATA.socials[i].followers=+bl.querySelector('.as-followers').value||0;
    DATA.socials[i].views=+bl.querySelector('.as-views').value||0;
    DATA.socials[i].growth=+bl.querySelector('.as-growth').value||0;
  });
  document.querySelectorAll('#a_biz .admin-block').forEach((bl,i)=>{
    if(!DATA.businesses[i])return;
    DATA.businesses[i].emoji=bl.querySelector('.ab-emoji').value;
    DATA.businesses[i].name=bl.querySelector('.ab-name').value;
    DATA.businesses[i].revenue=+bl.querySelector('.ab-revenue').value||0;
    DATA.businesses[i].sales=+bl.querySelector('.ab-sales').value||0;
    DATA.businesses[i].source=bl.querySelector('.ab-source').value;
  });
  document.querySelectorAll('#a_goals .admin-block').forEach((bl,i)=>{
    if(!DATA.goals[i])return;
    DATA.goals[i].name=bl.querySelector('.ag-name').value;
    DATA.goals[i].current=+bl.querySelector('.ag-current').value||0;
    DATA.goals[i].target=+bl.querySelector('.ag-target').value||0;
  });
}

function addSocial(){syncAdminToData();DATA.socials.push({id:'s'+Date.now(),platform:'tiktok',handle:'',followers:0,views:0,growth:0});renderAdminSocials();}
function delSocial(i){syncAdminToData();DATA.socials.splice(i,1);renderAdminSocials();}
function addBiz(){syncAdminToData();DATA.businesses.push({id:'b'+Date.now(),name:'',emoji:'💼',revenue:0,sales:0,source:'manual'});renderAdminBiz();}
function delBiz(i){syncAdminToData();DATA.businesses.splice(i,1);renderAdminBiz();}
function addGoal(){syncAdminToData();DATA.goals.push({id:'g'+Date.now(),name:'',current:0,target:0});renderAdminGoals();}
function delGoal(i){syncAdminToData();DATA.goals.splice(i,1);renderAdminGoals();}

function saveAdmin(){
  syncAdminToData();
  saveData();
  renderAll();
  closeAdmin();
  const f=document.getElementById('savedFlash');f.classList.add('show');setTimeout(()=>f.classList.remove('show'),1600);
}

/* ============================================================
   EXPORT / IMPORT (for Supabase migration + backup)
   ============================================================ */
function exportData(){
  const blob=new Blob([JSON.stringify(DATA,null,2)],{type:'application/json'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');a.href=url;
  a.download='shadow-os-backup-'+new Date().toISOString().slice(0,10)+'.json';
  document.body.appendChild(a);a.click();document.body.removeChild(a);URL.revokeObjectURL(url);
}
function importData(e){
  const file=e.target.files[0];if(!file)return;
  const reader=new FileReader();
  reader.onload=ev=>{
    try{
      const imported=JSON.parse(ev.target.result);
      DATA={...JSON.parse(JSON.stringify(DEFAULT_DATA)),...imported};
      saveData();populateAdmin();renderAll();
      const f=document.getElementById('savedFlash');f.textContent='✓ Imported';f.classList.add('show');setTimeout(()=>{f.classList.remove('show');f.textContent='✓ Saved';},1600);
    }catch(err){alert('Could not read that file — make sure it is a Shadow OS backup.');}
  };
  reader.readAsText(file);
  e.target.value='';
}

/* ============================================================
   INIT
   ============================================================ */
initChartHover();
/* gate is shown by default; app stays locked until unlock */
</script>
</body>
</html>
