/* ============================================================
   REVENUE CHART
   ============================================================ */
function renderChart(){
  const data=DATA.revHistory&&DATA.revHistory.length?DATA.revHistory:[0];
  const svg=document.getElementById('revSvg');
  const W=700,H=200,pad=8;
  const max=Math.max(...data,1)*1.15,min=0;
  const step=data.length>1?W/(data.length-1):W;
  const pts=data.map((v,i)=>[i*step,H-pad-((v-min)/(max-min))*(H-pad*2)]);
  const line=pts.map((p,i)=>`${i===0?'M':'L'}${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(' ');
  const area=line+` L${W},${H} L0,${H} Z`;
  let grid='';for(let i=0;i<=4;i++){const y=pad+(H-pad*2)*i/4;const val=Math.round(max*(1-i/4));grid+=`<line class="area-grid-line" x1="0" y1="${y}" x2="${W}" y2="${y}"/><text class="area-y-lbl" x="4" y="${y-4}">${fmtMoney(val)}</text>`;}
  svg.innerHTML=`<defs><linearGradient id="rg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.28"/><stop offset="100%" stop-color="#FFFFFF" stop-opacity="0"/></linearGradient></defs>${grid}<path d="${area}" fill="url(#rg)"/><path d="${line}" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linejoin="round"/><circle class="hover-dot" id="revDot" r="5" fill="#FFFFFF" stroke="#0A0A0C" stroke-width="2.5"/>`;
  svg._pts=pts;svg._data=data;
}
function initChartHover(){
  const svg=document.getElementById('revSvg');const tip=document.getElementById('revTip');
  svg.addEventListener('mousemove',e=>{
    if(!svg._data)return;
    const rect=svg.getBoundingClientRect();const x=(e.clientX-rect.left)/rect.width*700;
    const step=svg._data.length>1?700/(svg._data.length-1):700;let idx=Math.round(x/step);idx=Math.max(0,Math.min(svg._data.length-1,idx));
    const p=svg._pts[idx];const d=document.getElementById('revDot');if(d){d.setAttribute('cx',p[0]);d.setAttribute('cy',p[1]);d.style.opacity=1;}
    tip.style.opacity=1;
    document.getElementById('revTipD').textContent=`Day ${idx+1}`;
    document.getElementById('revTipV').textContent=fmtMoney(svg._data[idx]);
    const px=(p[0]/700)*rect.width;tip.style.left=Math.min(rect.width-85,Math.max(0,px-40))+'px';tip.style.top=(p[1]/200*rect.height-50)+'px';
  });
  svg.addEventListener('mouseleave',()=>{tip.style.opacity=0;const d=document.getElementById('revDot');if(d)d.style.opacity=0;});
}

