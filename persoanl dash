  document.getElementById('greetDate').textContent=`${days[d.getDay()]} · ${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`;
  const h=d.getHours();
  const part=h<12?'Good morning':h<18?'Good afternoon':'Good evening';
  document.getElementById('greetH').textContent=`${part}, ${DATA.name||'TCF'}.`;
}

