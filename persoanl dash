<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TCF — Command Centre</title>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --bg:#050506;--bg2:#0E0E11;--bg3:#131316;--bg4:#1A1A1E;--bg5:#1C1C1F;
  --wire:#242428;--wire2:#2E2E34;--wire3:#40404A;
  --grn:#FFFFFF;--grn-dim:rgba(255,255,255,0.1);--grn-glow:rgba(255,255,255,0.18);
  --gold:#E8B54D;--gold-dim:rgba(232,181,77,0.1);
  --pink:#C9C9CF;--pink-dim:rgba(255,46,126,0.1);
  --blu:#4DA3FF;--blu-dim:rgba(77,163,255,0.1);
  --viol:#A9A9B0;--viol-dim:rgba(155,125,255,0.1);
  --red:#C9C9CF;--red-dim:rgba(255,69,87,0.1);
  --wt:#FFFFFF;--wt2:#B4B4BC;--wt3:#6C6C74;--wt4:#28282D;
}
html{scroll-behavior:smooth;}
body{background:var(--bg);color:var(--wt);font-family:'Instrument Sans',sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden;}
::selection{background:var(--grn);color:#000;}
::-webkit-scrollbar{width:9px;height:9px;}::-webkit-scrollbar-track{background:transparent;}::-webkit-scrollbar-thumb{background:var(--wire2);border-radius:5px;}
.m{font-family:'JetBrains Mono',monospace;}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;}
input,select{font-family:inherit;}
body::before{content:'';position:fixed;top:-220px;left:15%;width:760px;height:460px;background:radial-gradient(ellipse,rgba(255,255,255,0.07),transparent 70%);pointer-events:none;z-index:0;}

/* ===== LOGIN GATE ===== */
.gate{position:fixed;inset:0;background:var(--bg);z-index:1000;display:flex;align-items:center;justify-content:center;flex-direction:column;padding:20px;}
.gate.hidden{display:none;}
.gate-box{width:100%;max-width:380px;text-align:center;}
.gate-logo{width:64px;height:64px;margin:0 auto 24px;background:var(--grn);border-radius:16px;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 40px var(--grn-glow);}
.gate-logo::before{content:'';width:24px;height:24px;background:#050506;transform:rotate(45deg);border-radius:4px;}
.gate-h{font-family:'Space Grotesk',sans-serif;font-size:27px;font-weight:700;letter-spacing:-0.025em;margin-bottom:8px;}
.gate-sub{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--wt3);letter-spacing:0.15em;text-transform:uppercase;margin-bottom:32px;}
.gate-input{width:100%;background:var(--bg3);border:1px solid var(--wire2);border-radius:12px;padding:15px 18px;color:var(--wt);font-size:15px;text-align:center;letter-spacing:0.1em;margin-bottom:12px;transition:border 0.15s;}
.gate-input:focus{outline:none;border-color:var(--grn);}
.gate-btn{width:100%;background:var(--grn);color:#050506;font-weight:700;font-size:15px;padding:15px;border-radius:12px;transition:all 0.15s;}
.gate-btn:hover{background:#ffffff;}
.gate-err{color:var(--red);font-size:12px;margin-top:12px;height:16px;font-family:'JetBrains Mono',monospace;}
.gate-hint{margin-top:24px;font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--wt4);letter-spacing:0.1em;}

.app{display:flex;min-height:100vh;position:relative;z-index:2;}
.app.locked{display:none;}

/* ===== SIDEBAR ===== */
.side{width:240px;flex-shrink:0;background:var(--bg2);border-right:1px solid var(--wire);display:flex;flex-direction:column;position:sticky;top:0;height:100vh;z-index:50;}
.side-top{padding:24px 22px 20px;border-bottom:1px solid var(--wire);}
.logo{display:flex;align-items:center;gap:11px;}
.logo-mark{width:32px;height:32px;background:var(--grn);border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 4px 16px var(--grn-glow);}
.logo-mark::before{content:'';width:12px;height:12px;background:#050506;transform:rotate(45deg);border-radius:2px;}
.logo-txt{font-family:'Space Grotesk',sans-serif;font-size:16px;font-weight:700;letter-spacing:0.03em;}
.logo-txt span{color:var(--grn);}
.logo-sub{font-family:'JetBrains Mono',monospace;font-size:8px;color:var(--wt3);letter-spacing:0.2em;text-transform:uppercase;margin-top:8px;margin-left:43px;}
.nav{padding:16px 12px;flex:1;overflow-y:auto;}
.nav-lbl{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.2em;color:var(--wt3);text-transform:uppercase;padding:0 12px;margin:18px 0 8px;}
.nav-lbl:first-child{margin-top:0;}
.nav-item{display:flex;align-items:center;gap:12px;padding:11px 13px;border-radius:10px;cursor:pointer;transition:all 0.14s;margin-bottom:2px;position:relative;}
.nav-item:hover{background:var(--bg3);}
.nav-item.active{background:var(--grn-dim);}
.nav-item.active::before{content:'';position:absolute;left:0;top:50%;transform:translateY(-50%);width:3px;height:18px;background:var(--grn);border-radius:0 3px 3px 0;}
.nav-ic{width:17px;height:17px;flex-shrink:0;color:var(--wt3);}
.nav-item:hover .nav-ic{color:var(--wt2);}
.nav-item.active .nav-ic{color:var(--grn);}
.nav-tx{font-size:13px;color:var(--wt2);font-weight:500;}
.nav-item.active .nav-tx{color:var(--wt);font-weight:600;}
.side-foot{padding:14px 16px;border-top:1px solid var(--wire);display:flex;flex-direction:column;gap:8px;}
.foot-btn{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:9px;font-size:12px;color:var(--wt2);transition:all 0.14s;font-weight:500;}
.foot-btn:hover{background:var(--bg3);color:var(--wt);}
.foot-btn svg{width:15px;height:15px;}
.foot-btn.lock:hover{color:var(--red);}

/* ===== MAIN ===== */
.main{flex:1;min-width:0;display:flex;flex-direction:column;}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:18px 30px;border-bottom:1px solid var(--wire);background:rgba(8,9,12,0.85);backdrop-filter:blur(16px);position:sticky;top:0;z-index:40;gap:20px;}
.tb-l{display:flex;flex-direction:column;gap:4px;}
.tb-title{font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:700;letter-spacing:-0.025em;}
.tb-crumb{font-family:'JetBrains Mono',monospace;font-size:8.5px;color:var(--wt3);letter-spacing:0.12em;text-transform:uppercase;}
.tb-r{display:flex;align-items:center;gap:10px;}
.btn-p{background:var(--grn);color:#050506;font-weight:600;font-size:12.5px;padding:10px 16px;border-radius:10px;display:flex;align-items:center;gap:7px;transition:all 0.14s;}
.btn-p:hover{background:#ffffff;}
.btn-g{background:var(--bg3);border:1px solid var(--wire2);color:var(--wt);font-weight:500;font-size:12.5px;padding:10px 15px;border-radius:10px;transition:all 0.14s;display:flex;align-items:center;gap:7px;}
.btn-g:hover{background:var(--bg4);border-color:var(--wire3);}
.btn-g svg{width:14px;height:14px;}

.content{padding:38px 44px 90px;flex:1;max-width:1400px;}
.page{display:none;}
.page.active{display:block;animation:fade 0.3s cubic-bezier(0.2,0.7,0.3,1);}
@keyframes fade{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}

/* GREETING */
.greet{margin-bottom:38px;}
.greet-date{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--grn);letter-spacing:0.18em;text-transform:uppercase;margin-bottom:10px;}
.greet-h{font-family:'Space Grotesk',sans-serif;font-size:34px;letter-spacing:-0.045em;font-weight:700;letter-spacing:-0.03em;margin-bottom:8px;}
.greet-sub{font-size:14px;color:var(--wt2);}

/* KPI */
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-bottom:20px;}
.kpi{background:var(--bg2);border:1px solid var(--wire);border-radius:16px;padding:24px;position:relative;overflow:hidden;transition:all 0.16s;}
.kpi:hover{border-color:var(--wire3);}
.kpi-glow{position:absolute;top:-30px;right:-30px;width:90px;height:90px;border-radius:50%;opacity:0.4;filter:blur(32px);}
.kpi-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;position:relative;}
.kpi-lbl{font-family:'JetBrains Mono',monospace;font-size:8.5px;color:var(--wt3);letter-spacing:0.12em;text-transform:uppercase;}
.kpi-ic{width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;}
.kpi-val{font-family:'Space Grotesk',sans-serif;font-size:30px;letter-spacing:-0.035em;font-weight:700;letter-spacing:-0.02em;line-height:1;margin-bottom:8px;position:relative;font-variant-numeric:tabular-nums;}
.kpi-sub{display:flex;align-items:center;gap:7px;position:relative;}
.kpi-tag{font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:600;padding:2px 7px;border-radius:5px;}
.kpi-tag.up{background:var(--grn-dim);color:var(--grn);}
.kpi-tag.dn{background:var(--red-dim);color:var(--red);}
.kpi-note{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--wt3);}

.sec-t{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--wt3);text-transform:uppercase;letter-spacing:0.28em;margin:38px 0 18px;display:flex;align-items:center;gap:12px;}
.sec-t::after{content:'';flex:1;height:1px;background:var(--wire);}
.sec-t .api{font-family:'JetBrains Mono',monospace;font-size:8px;color:var(--wt4);border:1px solid var(--wire2);padding:2px 8px;border-radius:5px;letter-spacing:0.1em;text-transform:uppercase;}

/* SOCIAL CARDS */
.socials{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:20px;}
.social{background:var(--bg2);border:1px solid var(--wire);border-radius:16px;padding:22px;transition:all 0.14s;position:relative;}
.social:hover{border-color:var(--wire3);}
.social-hd{display:flex;align-items:center;gap:11px;margin-bottom:16px;}
.social-ic{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.social-ic svg{width:20px;height:20px;}
.social-nm{font-size:14px;font-weight:600;}
.social-handle{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--wt3);margin-top:2px;}
.social-stats{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.sstat-l{font-family:'JetBrains Mono',monospace;font-size:8px;color:var(--wt3);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:5px;}
.sstat-v{font-size:19px;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:-0.01em;}
.social-foot{margin-top:14px;padding-top:12px;border-top:1px solid var(--wire);display:flex;align-items:center;justify-content:space-between;}
.social-growth{font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:600;}
.social-growth.up{color:var(--grn);}
.social-src{font-family:'JetBrains Mono',monospace;font-size:8px;color:var(--wt4);letter-spacing:0.05em;}

/* MONEY / BUSINESS */
.grid{display:grid;gap:20px;margin-bottom:20px;}
.g-2-1{grid-template-columns:1.6fr 1fr;}
.card{background:var(--bg2);border:1px solid var(--wire);border-radius:14px;overflow:hidden;}
.card-hd{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-bottom:1px solid var(--wire);gap:12px;}
.card-ti{font-size:14px;font-weight:600;display:flex;align-items:center;gap:9px;}
.card-ti .dot{width:6px;height:6px;border-radius:50%;background:var(--grn);box-shadow:0 0 8px var(--grn);}
.card-sub{font-family:'JetBrains Mono',monospace;font-size:8.5px;color:var(--wt3);text-transform:uppercase;letter-spacing:0.1em;}
.card-bd{padding:18px;}

.biz-row{display:flex;align-items:center;gap:14px;padding:14px 0;border-bottom:1px solid var(--wire);}
.biz-row:last-child{border-bottom:none;}
.biz-ic{width:40px;height:40px;border-radius:10px;background:var(--bg4);border:1px solid var(--wire2);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;}
.biz-main{flex:1;min-width:0;}
.biz-nm{font-size:13.5px;font-weight:600;margin-bottom:2px;}
.biz-meta{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--wt3);}
.biz-rev{text-align:right;flex-shrink:0;}
.biz-rev-v{font-size:16px;font-weight:700;font-variant-numeric:tabular-nums;}
.biz-rev-l{font-family:'JetBrains Mono',monospace;font-size:8px;color:var(--wt3);text-transform:uppercase;letter-spacing:0.05em;margin-top:2px;}

/* CHART */
.areawrap{position:relative;height:200px;}
.area-svg{width:100%;height:100%;overflow:visible;}
.area-grid-line{stroke:var(--wire);stroke-width:1;stroke-dasharray:3 4;}
.area-y-lbl{font-family:'JetBrains Mono',monospace;font-size:9px;fill:var(--wt3);}
.chart-tip{position:absolute;background:var(--bg5);border:1px solid var(--wire3);border-radius:8px;padding:8px 11px;pointer-events:none;opacity:0;transition:opacity 0.15s;z-index:10;}
.chart-tip .d{font-family:'JetBrains Mono',monospace;font-size:8px;color:var(--wt3);text-transform:uppercase;margin-bottom:3px;}
.chart-tip .v{font-family:'JetBrains Mono',monospace;font-size:14px;font-weight:700;color:var(--grn);}
.hover-dot{opacity:0;transition:opacity 0.15s;}

/* GOALS */
.goal{display:flex;align-items:center;gap:14px;padding:13px 0;border-bottom:1px solid var(--wire);}
.goal:last-child{border-bottom:none;}
.goal-main{flex:1;}
.goal-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;}
.goal-nm{font-size:13px;font-weight:500;color:var(--wt);}
.goal-pct{font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:600;color:var(--grn);}
.goal-bar{height:6px;background:var(--bg4);border-radius:3px;overflow:hidden;}
.goal-bar i{display:block;height:100%;background:var(--grn);border-radius:3px;transition:width 0.4s;}

/* ===== ADMIN PANEL ===== */
.admin-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.6);backdrop-filter:blur(3px);opacity:0;pointer-events:none;transition:opacity 0.25s;z-index:80;}
.admin-overlay.open{opacity:1;pointer-events:auto;}
.admin{position:fixed;top:0;right:0;height:100vh;width:480px;max-width:94vw;background:var(--bg2);border-left:1px solid var(--wire2);transform:translateX(100%);transition:transform 0.3s cubic-bezier(0.3,0.8,0.3,1);z-index:81;overflow-y:auto;}
.admin.open{transform:translateX(0);}
.admin-hd{display:flex;align-items:center;justify-content:space-between;padding:22px 24px;border-bottom:1px solid var(--wire);position:sticky;top:0;background:var(--bg2);z-index:2;}
.admin-ti{font-size:18px;font-weight:700;display:flex;align-items:center;gap:10px;}
.admin-ti .badge{font-family:'JetBrains Mono',monospace;font-size:8px;background:var(--grn);color:#050506;padding:3px 8px;border-radius:5px;letter-spacing:0.1em;}
.admin-x{width:34px;height:34px;border-radius:9px;background:var(--bg3);border:1px solid var(--wire2);display:flex;align-items:center;justify-content:center;color:var(--wt2);transition:all 0.14s;}
.admin-x:hover{background:var(--bg4);color:var(--wt);}
.admin-bd{padding:24px;}
.admin-sec{margin-bottom:28px;}
.admin-sec-t{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--wt3);text-transform:uppercase;letter-spacing:0.15em;margin-bottom:14px;display:flex;align-items:center;gap:10px;}
.admin-sec-t::after{content:'';flex:1;height:1px;background:var(--wire);}
.field{margin-bottom:14px;}
.field-l{font-size:11px;color:var(--wt2);font-weight:500;margin-bottom:6px;display:block;}
.field-i{width:100%;background:var(--bg3);border:1px solid var(--wire2);border-radius:9px;padding:11px 13px;color:var(--wt);font-size:13px;transition:border 0.14s;}
.field-i:focus{outline:none;border-color:var(--grn);}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.admin-block{background:var(--bg3);border:1px solid var(--wire2);border-radius:11px;padding:16px;margin-bottom:12px;position:relative;}
.admin-block-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;}
.admin-block-ti{font-size:12.5px;font-weight:600;color:var(--wt);}
.block-del{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--red);border:1px solid var(--red-dim);padding:4px 9px;border-radius:6px;transition:all 0.14s;}
.block-del:hover{background:var(--red-dim);}
.add-btn{width:100%;background:none;border:1px dashed var(--wire3);border-radius:10px;padding:12px;color:var(--grn);font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.05em;text-transform:uppercase;transition:all 0.14s;font-weight:600;}
.add-btn:hover{background:var(--bg3);border-color:var(--grn);}
.admin-save{position:sticky;bottom:0;background:var(--bg2);border-top:1px solid var(--wire);padding:16px 24px;display:flex;gap:10px;}
.save-btn{flex:1;background:var(--grn);color:#050506;font-weight:700;font-size:14px;padding:13px;border-radius:10px;transition:all 0.14s;}
.save-btn:hover{background:#ffffff;}
.saved-flash{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--grn);color:#050506;font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;padding:11px 22px;border-radius:8px;opacity:0;transition:all 0.3s;z-index:200;pointer-events:none;}
.saved-flash.show{opacity:1;transform:translateX(-50%) translateY(0);}

.api-hint{background:var(--blu-dim);border:1px solid rgba(77,163,255,0.2);border-radius:10px;padding:13px 15px;font-size:11.5px;color:var(--wt2);line-height:1.6;margin-bottom:16px;}
.api-hint b{color:var(--blu);}

.empty{text-align:center;padding:50px 20px;color:var(--wt3);font-size:13px;}

@media(max-width:1100px){.kpis{grid-template-columns:repeat(2,1fr);}.socials{grid-template-columns:1fr;}.g-2-1{grid-template-columns:1fr;}}
@media(max-width:720px){.side{display:none;}.content{padding:18px;}.admin{width:100%;}.greet-h{font-size:24px;}}
</style>
</head>
<body>

<!-- LOGIN GATE -->
<div class="gate" id="gate">
  <div class="gate-box">
    <div class="gate-logo"></div>
    <div class="gate-h">Command Centre</div>
    <div class="gate-sub">TCF · Access Required</div>
    <input type="password" class="gate-input" id="gateInput" placeholder="Enter password" autocomplete="off">
    <button class="gate-btn" onclick="tryUnlock()">Unlock</button>
    <div class="gate-err" id="gateErr"></div>
    <div class="gate-hint">Default: shadow2026 · change it in Admin</div>
  </div>
</div>

<div class="app locked" id="app">
  <aside class="side">
    <div class="side-top">
      <div class="logo"><div class="logo-mark"></div><div class="logo-txt">TCF<span> OS</span></div></div>
      <div class="logo-sub">Personal Command</div>
    </div>
    <nav class="nav">
      <div class="nav-lbl">Overview</div>
      <div class="nav-item active" data-p="command"><svg class="nav-ic" viewBox="0 0 24 24" fill="none"><path d="M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z" stroke="currentColor" stroke-width="1.8"/></svg><span class="nav-tx">Command</span></div>
      <div class="nav-item" data-p="socials"><svg class="nav-ic" viewBox="0 0 24 24" fill="none"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 01-3.4 0" stroke="currentColor" stroke-width="1.8"/></svg><span class="nav-tx">Socials</span></div>
      <div class="nav-item" data-p="money"><svg class="nav-ic" viewBox="0 0 24 24" fill="none"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" stroke="currentColor" stroke-width="1.8"/></svg><span class="nav-tx">Money</span></div>
      <div class="nav-item" data-p="goals"><svg class="nav-ic" viewBox="0 0 24 24" fill="none"><path d="M22 12h-4l-3 9L9 3l-3 9H2" stroke="currentColor" stroke-width="1.8"/></svg><span class="nav-tx">Goals</span></div>
