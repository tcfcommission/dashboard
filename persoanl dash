  snapchat:{name:'Snapchat',color:'#B8B8BE',bg:'rgba(232,181,77,0.12)',svg:'<path d="M12 2c3 0 5 2 5 5v3l3 1-3 2v2l2 1-4 2-3 2-3-2-4-2 2-1v-2l-3-2 3-1V7c0-3 2-5 5-5z" stroke="#E8B54D" stroke-width="1.6" fill="none"/>'},
  other:{name:'Platform',color:'#FFFFFF',bg:'rgba(0,230,118,0.12)',svg:'<circle cx="12" cy="12" r="9" stroke="#FFFFFF" stroke-width="2"/><path d="M12 8v8M8 12h8" stroke="#FFFFFF" stroke-width="2"/>'}
